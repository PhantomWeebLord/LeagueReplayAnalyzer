# Replay Analyzer settings. All of them are optional.
# The app does not load this file by itself: set these in your shell or system environment.
# Never commit a real key. A key saved inside the app stays in config.json, which git ignores.

# Riot API key from https://developer.riotgames.com (overrides the key saved in the app)
RIOT_API_KEY=

# Port of the local app
LRA_PORT=8766

# Address of League's Live Client API
LRA_LIVE_URL=https://127.0.0.1:2999
